enum WalletOwnerType {
  DRIVER
}

enum WalletTransactionType {
  TRIP_CREDIT
  PAYOUT_DEBIT
}

model Wallet {
  id        String          @id @default(cuid())
  ownerType WalletOwnerType
  ownerId   String
  balance   Decimal         @db.Decimal(14, 4) @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  transactions WalletTransaction[]

  @@unique([ownerType, ownerId])
  @@index([ownerId])
}

model WalletTransaction {
  id           String                @id @default(cuid())
  walletId     String
  type         WalletTransactionType
  amount       Decimal               @db.Decimal(14, 4)
  balanceAfter Decimal               @db.Decimal(14, 4)
  bookingId    String?
  tripId       String?               @unique
  payoutId     String?               @unique
  description  String?
  createdAt    DateTime              @default(now())

  wallet Wallet  @relation(fields: [walletId], references: [id], onDelete: Cascade)
  payout Payout? @relation(fields: [payoutId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([bookingId])
  @@index([type])
}
