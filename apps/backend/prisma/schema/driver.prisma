enum DriverStatus {
  INVITED
  PENDING
  ACTIVE
  INACTIVE
  SUSPENDED
  REJECTED
}

enum DriverShift {
  DAY
  NIGHT
  FLEXIBLE
}

enum DriverPresenceStatus {
  OFFLINE
  ONLINE
}

enum DriverShiftSessionStatus {
  OPEN
  CLOSED
}

enum DriverShiftEndedReason {
  DRIVER
  ADMIN
  WINDOW_ENDED
  HEARTBEAT_TIMEOUT
  DEVICE_TAKEOVER
}

enum DriverOnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  DOCUMENTS_PENDING
  UNDER_REVIEW
  COMPLETED
}

enum DriverApprovalStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

/** Bolt-style activity: outcome of a booking request shown to a driver. */
enum DriverRequestOutcome {
  PENDING
  FINISHED
  NOT_ACCEPTED
  DRIVER_CANCELLED
  CLIENT_CANCELLED
  CLIENT_NO_SHOW
}

enum DriverDocumentType {
  CHAUFFEUR_FRONT
  CHAUFFEUR_BACK
  KIWA_PERMIT
  LICENSE_FRONT
  LICENSE_BACK
  NATIONAL_ID_FRONT
  NATIONAL_ID_BACK
  AIRPORT_STA_PASS
  CAR_REGISTRATION
  CAR_FRONT
  CAR_BACK
  CAR_LEFT
  CAR_RIGHT
  CAR_INSIDE
  LICENSE_PLATE
  INSURANCE
}

enum DriverDocumentVerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  EXPIRED
}

enum DriverLanguageFluency {
  FLUENT
  CONVERSATIONAL
  NORMAL
}

enum DriverDeleteStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Driver {
  id                String                 @id @default(cuid())
  userId            String                 @unique
  applicationNumber String                 @unique
  firstName         String
  lastName          String
  email             String
  phone             String?
  operatingCountry  String?
  operatingCity     String?
  homeAddress       String?
  houseNo           String?
  streetName        String?
  postalCode        String?
  city              String?
  province          String?
  country           String?
  countryCode       String?
  kvkNo             String?
  licenseExpiry     DateTime?
  yearsExperience   Int?
  shift             DriverShift            @default(FLEXIBLE)
  startTime         String?
  endTime           String?
  dressesInSuit     Boolean                @default(false)
  services          String[]               @default([])
  status            DriverStatus           @default(PENDING)
  onboardingStatus  DriverOnboardingStatus @default(NOT_STARTED)
  approvalStatus            DriverApprovalStatus   @default(PENDING)
  onboardingPersonal        Boolean                @default(false)
  onboardingEmailVerified   Boolean                @default(false)
  onboardingDetails         Boolean                @default(false)
  onboardingVehicle         Boolean                @default(false)
  onboardingDocuments       Boolean                @default(false)
  presenceStatus            DriverPresenceStatus   @default(OFFLINE)
  presenceUpdatedAt         DateTime?
  lastHeartbeatAt           DateTime?
  presenceDeviceId          String?
  lastLat                   Float?
  lastLng                   Float?
  locationUpdatedAt         DateTime?
  fcmToken                  String?
  stripeCustomerId          String?                @unique
  subscriptionFreeUsedAt    DateTime?
  about                     String?
  notes                     String?
  avatarUrl         String?
  avatarPublicId    String?
  /** Denormalized marketplace card stats (updated on trip complete / passenger ratings). */
  /** Running average from Customer DriverReview rows (0 until first review). */
  ratingAvg         Float                  @default(0)
  ratingCount       Int                    @default(0)
  completedTrips    Int                    @default(0)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  deletedAt         DateTime?

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle      DriverVehicle?
  documents    DriverDocument[]
  languages    DriverLanguage[]
  settings     DriverSettings?
  pushDevices  DriverPushDevice[]
  bankAccounts DriverBankAccount[]
  shiftSessions       DriverShiftSession[]
  trips               Trip[]
  locationPoints      TripLocationPoint[]
  tripReviews         TripReview[]
  driverReviews       DriverReview[]
  bookingDeclines     DriverBookingDecline[]
  bookingOffers       BookingOffer[]
  requestEvents       DriverRequestEvent[]
  deleteRequests DriverDeleteRequest[]

  @@index([status])
  @@index([approvalStatus])
  @@index([onboardingStatus])
  @@index([presenceStatus])
  @@index([operatingCity])
  @@index([email])
  @@index([phone])
  @@index([deletedAt])
  @@index([completedTrips])
  @@index([ratingAvg])
}

/**
 * Durable impression when a booking request is shown/pushed to a driver.
 * One row per (driver, booking); outcome updated as the request resolves.
 */
model DriverRequestEvent {
  id        String               @id @default(cuid())
  driverId  String
  bookingId String
  tripId    String?
  outcome   DriverRequestOutcome @default(PENDING)
  outcomeAt DateTime?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  trip    Trip?   @relation(fields: [tripId], references: [id], onDelete: SetNull)

  @@unique([driverId, bookingId])
  @@index([driverId, createdAt])
  @@index([driverId, outcome, outcomeAt])
  @@index([bookingId])
  @@index([tripId])
  @@index([outcome])
}

/** Driver self-serve request to delete their account (admin processes later). */
model DriverDeleteRequest {
  id             String             @id @default(cuid())
  driverId       String
  reason         String?
  status         DriverDeleteStatus @default(PENDING)
  /** Driver.status before deactivate-on-request; restored on reject/cancel. */
  previousStatus DriverStatus?
  processedAt    DateTime?
  processedBy    String?
  adminNote      String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([status])
  @@index([driverId, status])
  @@index([createdAt])
}

/** Per-driver dismiss of an available booking (hidden only for that driver). */
model DriverBookingDecline {
  id        String   @id @default(cuid())
  driverId  String
  bookingId String
  createdAt DateTime @default(now())

  driver  Driver  @relation(fields: [driverId], references: [id], onDelete: Cascade)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([driverId, bookingId])
  @@index([driverId])
  @@index([bookingId])
  @@index([createdAt])
}

/** Spoken languages (ISO 639-1 code + fluency). Multi-select up to DRIVER_LANGUAGES_MAX. */
model DriverLanguage {
  id        String                 @id @default(cuid())
  driverId  String
  /** ISO 639-1 language code (e.g. en, nl, tr). Allowlisted in app constants. */
  code      String
  fluency   DriverLanguageFluency
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, code])
  @@index([driverId])
  @@index([code])
}

model DriverShiftSession {
  id                 String                   @id @default(cuid())
  driverId           String
  status             DriverShiftSessionStatus @default(OPEN)
  startedAt          DateTime                 @default(now())
  endedAt            DateTime?
  durationSeconds    Int?
  /** Seconds online after scheduled endTime (0 if ended on time / flexible). */
  extraSeconds       Int?
  shiftType          DriverShift
  scheduledStartTime String?
  scheduledEndTime   String?
  timezone           String
  endedReason        DriverShiftEndedReason?
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, status])
  @@index([status, startedAt])
}

model DriverSettings {
  id                 String   @id @default(cuid())
  driverId           String   @unique
  email     Boolean  @default(true)
  push      Boolean  @default(true)
  timezone  String   @default("Europe/Amsterdam")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
}

model DriverPushDevice {
  id        String   @id @default(cuid())
  driverId  String
  token     String   @unique
  deviceId  String?
  platform  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, deviceId])
  @@index([driverId])
}

model DriverBankAccount {
  id                String   @id @default(cuid())
  driverId          String
  accountHolderName String
  iban              String
  bic               String?
  bankName          String?
  isDefault         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  driver  Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@unique([driverId, iban])
  @@index([driverId])
  @@index([iban])
  @@index([driverId, isDefault])
}

model DriverApplicationSequence {
  id        String   @id @default("global")
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model DriverVehicle {
  id                String   @id @default(cuid())
  driverId          String   @unique
  vehicleCategoryId String
  make              String
  model             String
  year              Int
  color             String?
  licensePlate      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  deletedAt         DateTime?

  driver          Driver                          @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleCategory VehicleCategory                 @relation(fields: [vehicleCategoryId], references: [id], onDelete: Restrict)
  luggageCapacity DriverVehicleLuggageCapacity[]
  trips           Trip[]
  bookingOffers   BookingOffer[]

  @@index([licensePlate])
  @@index([vehicleCategoryId])
  @@index([deletedAt])
}

model DriverVehicleLuggageCapacity {
  id            String   @id @default(cuid())
  vehicleId     String
  luggageTypeId String
  quantity      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  vehicle     DriverVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  luggageType LuggageType   @relation(fields: [luggageTypeId], references: [id], onDelete: Restrict)

  @@unique([vehicleId, luggageTypeId])
  @@index([vehicleId])
  @@index([luggageTypeId])
}

model DriverDocument {
  id                 String                            @id @default(cuid())
  driverId           String
  documentType       DriverDocumentType
  fileId             String?
  publicId           String
  url                String
  originalName       String?
  mimeType           String?
  size               Int?
  expiryDate         DateTime?
  verificationStatus DriverDocumentVerificationStatus  @default(PENDING)
  uploadedAt         DateTime                          @default(now())
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt
  deletedAt          DateTime?

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId])
  @@index([documentType])
  @@index([verificationStatus])
  @@index([deletedAt])
}
