enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  PARTIALLY_REFUNDED
  REFUNDED
}

/// What the payment is for. Domains react via purpose after Payment succeeds.
enum PaymentPurpose {
  BOOKING
  DRIVER_SUBSCRIPTION
  AGENCY_SUBSCRIPTION
}

/// Money movement. Linked to domains via purpose + referenceId.
/// method JSON: { provider, type?, brand?, last4?, expMonth?, expYear?, fingerprint?, walletType?, paidAt? }
/// checkout JSON: { sessionId?, checkoutUrl?, paymentIntentId?, idempotencyKey? }
model Payment {
  id             String         @id @default(cuid())
  purpose        PaymentPurpose @default(BOOKING)
  referenceId    String
  transactionId  String?        @unique
  amount         Decimal        @db.Decimal(14, 4)
  refundedAmount Decimal        @db.Decimal(14, 4) @default(0)
  status         PaymentStatus  @default(PENDING)
  method         Json?
  checkout       Json?
  failureCode    String?
  failureMessage String?
  paidAt         DateTime?
  cancelledAt    DateTime?
  refundedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@unique([purpose, referenceId])
  @@index([purpose])
  @@index([referenceId])
  @@index([status])
  @@index([transactionId])
  @@index([createdAt])
}

model PaymentWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

/// Transactional outbox for payment domain events (survives crash between DB update and emit).
model PaymentOutboxEvent {
  id          String    @id @default(cuid())
  event       String
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
  @@index([createdAt])
}
