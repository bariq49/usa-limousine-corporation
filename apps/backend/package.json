{
  "name": "@usa-limousine-corporation/backend",
  "version": "0.0.0",
  "private": true,
  "description": "USA Limousine Corporation platform API — NestJS backend foundation",
  "license": "UNLICENSED",
  "scripts": {
    "predev": "prisma generate",
    "prebuild": "prisma generate",
    "pretypecheck": "prisma generate",
    "pretest:e2e": "prisma generate && pnpm db:migrate:deploy:test",
    "dev": "nest start --watch",
    "dev:worker": "nest start --watch --entryFile worker",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "start:prod": "NODE_ENV=production node dist/main.js",
    "start:prod:worker": "NODE_ENV=production node dist/worker.js",
    "format": "prettier --write \"{src,test}/**/*.ts\" \"*.{json,md}\" --ignore-path ../../.prettierignore",
    "format:check": "prettier --check \"{src,test}/**/*.ts\" \"*.{json,md}\" --ignore-path ../../.prettierignore",
    "lint": "eslint \"{src,test}/**/*.ts\" --ignore-pattern \"src/generated/**\" --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json --noEmit",
    "test": "jest --config ./test/jest-unit.json --runInBand",
    "test:e2e": "NODE_ENV=test jest --config ./test/jest-e2e.json --runInBand",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:deploy:test": "NODE_ENV=test prisma migrate deploy",
    "db:migrate:check": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --exit-code",
    "db:migrate:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@bull-board/api": "^9.4.0",
    "@bull-board/express": "^9.4.0",
    "@nestjs/common": "^11.0.12",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.12",
    "@nestjs/event-emitter": "^3.1.0",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.12",
    "@nestjs/platform-socket.io": "^11.1.28",
    "@nestjs/swagger": "^11.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/websockets": "^11.1.28",
    "@prisma/client": "^6.6.0",
    "@socket.io/redis-adapter": "^8.2.1",
    "@socket.io/redis-emitter": "^5.1.0",
    "argon2": "^0.45.1",
    "bullmq": "^6.0.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.0",
    "cookie-parser": "^1.4.7",
    "firebase-admin": "^14.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^6.0.0",
    "nodemailer": "^9.0.4",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "square": "^46.0.0",
    "twilio": "^6.1.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.6",
    "@nestjs/schematics": "^11.0.3",
    "@nestjs/testing": "^11.1.28",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.10",
    "@types/nodemailer": "^8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.3",
    "dotenv": "^16.6.1",
    "jest": "^29.7.0",
    "prisma": "^6.6.0",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.8.2"
  }
}
