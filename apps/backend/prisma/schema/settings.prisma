enum PaymentMode {
  TEST
  LIVE
}

/// Singleton platform settings (id = "global").
model PlatformSettings {
  id                  String      @id @default("global")
  paymentMode         PaymentMode @default(TEST)
  payoutMin           Decimal     @default(10) @db.Decimal(14, 4)
  payoutIntervalDays  Int         @default(7)
  requireSubscription Boolean     @default(false)

  // --- Offer marketplace ---
  offerRadius              Float @default(8)
  offerExpandStep          Float @default(4)
  offerExpandMax           Float @default(24)
  offerGeoMatchCount       Int   @default(80)
  offerMaxPerBooking       Int   @default(20)
  offerMaxQuotesPerDriver  Int   @default(5)
  offerTtlMin              Int   @default(5)
  offerSessionTtlMin       Int   @default(15)
  offerQuoteMinFactor      Float @default(0.5)
  offerQuoteMaxFactor      Float @default(2.5)

  // --- Marketplace payment / cancel / no-show ---
  /** Minutes to pay after offer accept before auto-release to SEEKING_OFFERS. */
  paymentTimeoutMin                 Int @default(15)
  /** Customer/driver cancel before trip STARTED: refund this % of paid amount. */
  cancelRefundBeforeStartPercent    Int @default(100)
  /** Cancel after STARTED (before COMPLETE): refund this %. */
  cancelRefundAfterStartPercent     Int @default(50)
  /** When driver cancels a paid trip: refund this % to customer. */
  driverCancelRefundPercent         Int @default(100)
  /** If true, after driver cancel + refund, booking returns to SEEKING_OFFERS. */
  driverCancelReseek                Boolean @default(false)
  /** Free wait minutes after ARRIVED_AT_PICKUP before no-show is allowed. */
  pickupFreeWaitMin                 Int @default(10)
  /** Passenger no-show: refund this % (usually low / 0). */
  noShowRefundPercent               Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
