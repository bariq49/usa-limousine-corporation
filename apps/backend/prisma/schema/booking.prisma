enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingType {
  ONE_WAY
  RETURN
  HOURLY
  CREW_RIDE
}

model BookingSequence {
  id        String   @id @default("global")
  lastValue Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Booking {
  id                   String        @id @default(cuid())
  userId               String?
  vehicleCategoryId    String
  bookingNumber        String        @unique
  status               BookingStatus @default(DRAFT)
  bookingType          BookingType   @default(ONE_WAY)
  pricing              Json
  address              Json
  passenger            Json
  bookingTime          Json
  flightDetails        Json?
  meetAndGreet         Json?
  extraServices        Json?
  driverNotes          String?
  confirmedAt          DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleCategory VehicleCategory @relation(fields: [vehicleCategoryId], references: [id], onDelete: Restrict)
  luggage         BookingLuggage[]

  @@index([userId])
  @@index([vehicleCategoryId])
  @@index([status])
  @@index([bookingType])
  @@index([deletedAt])
}

model BookingLuggage {
  id            String @id @default(cuid())
  bookingId     String
  luggageTypeId String
  quantity      Int    @default(1)

  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  luggageType LuggageType @relation(fields: [luggageTypeId], references: [id], onDelete: Restrict)

  @@unique([bookingId, luggageTypeId])
  @@index([bookingId])
  @@index([luggageTypeId])
}
