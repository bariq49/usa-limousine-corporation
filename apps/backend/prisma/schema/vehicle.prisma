enum PricingType {
  FIXED
  PER_UNIT
  PERCENTAGE
}

enum PricingStatus {
  ACTIVE
  INACTIVE
}

model VehicleCategory {
  id          String  @id @default(cuid())
  name        String
  description String?
  image       String?

  passengerCount Int     @default(4)
  isActive       Boolean @default(true)

  luggageCapacity VehicleCategoryLuggageCapacity[]
  bookings        Booking[]
  quotes          Quote[]
  drivers         Driver[]
  pricing         VehicleCategoryPricing[]
  hourlyPricing   HourlyPricing[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([isActive])
  @@index([deletedAt])
}

model LuggageType {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  dimensions  String?
  image       String?
  price       Decimal? @db.Decimal(12, 2)
  isActive    Boolean  @default(true)

  capacities        VehicleCategoryLuggageCapacity[]
  bookingSelections BookingLuggage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model VehicleCategoryLuggageCapacity {
  id            String          @id @default(cuid())
  categoryId    String
  luggageTypeId String
  quantity      Int             @default(0)
  category      VehicleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  luggageType   LuggageType     @relation(fields: [luggageTypeId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([categoryId, luggageTypeId])
  @@index([categoryId])
  @@index([luggageTypeId])
}

model VehicleCategoryPricing {
  id String @id @default(cuid())

  vehicleCategoryId String

  minimumDistance Float
  maximumDistance Float?

  pricingType PricingType

  basePrice      Decimal  @db.Decimal(12, 2)
  perUnitRate    Decimal? @db.Decimal(12, 4)
  percentageRate Decimal? @db.Decimal(7, 4)

  status PricingStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleCategory VehicleCategory @relation(fields: [vehicleCategoryId], references: [id], onDelete: Cascade)

  @@index([vehicleCategoryId, status, minimumDistance])
  @@index([vehicleCategoryId, minimumDistance, maximumDistance])
}

model HourlyPricing {
  id String @id @default(cuid())

  vehicleCategoryId String

  durationHours     Int
  basePrice         Decimal @db.Decimal(12, 2)
  includedDistance  Float   @default(0)
  extraDistanceRate Float   @default(0)

  status PricingStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vehicleCategory VehicleCategory @relation(fields: [vehicleCategoryId], references: [id], onDelete: Cascade)

  @@unique([vehicleCategoryId, durationHours])
  @@index([status, durationHours])
}
