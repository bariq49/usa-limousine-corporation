enum BookingStatus {
  DRAFT
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum BookingType {
  ONE_WAY
  RETURN
  HOURLY
}

model Booking {
  id                   String        @id @default(cuid())
  userId               String?
  vehicleCategoryId    String
  bookingNumber        String        @unique
  status               BookingStatus @default(DRAFT)
  bookingType          BookingType   @default(ONE_WAY)
  vehicleCount         Int           @default(1)
  totalPrice           Decimal       @db.Decimal(12, 2)
  squareOrderId        String?       @unique
  squarePaymentLinkId  String?
  squarePaymentLinkUrl String?
  paymentMode          PaymentMode?
  quoteId              String?       @unique
  pricing              Json
  address              Json
  passenger            Json
  bookingTime          Json
  flightDetails        Json?
  meetAndGreet         Json?
  notes                String?
  returnNotes          String?
  notifyByEmail        Boolean       @default(true)
  notifyBySms          Boolean       @default(true)
  confirmedAt          DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  cancellationReason   String?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  deletedAt            DateTime?

  user            User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicleCategory VehicleCategory       @relation(fields: [vehicleCategoryId], references: [id], onDelete: Restrict)
  luggage         BookingLuggage[]
  extraServices   BookingExtraService[]
  payment         Payment?
  quote           Quote?                @relation(fields: [quoteId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([deletedAt, createdAt])
  @@index([vehicleCategoryId])
  @@index([status])
  @@index([bookingType])
}

model BookingLuggage {
  id            String  @id @default(cuid())
  bookingId     String
  luggageTypeId String
  quantity      Int     @default(1)
  unitPrice     Decimal @default(0) @db.Decimal(12, 2)

  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  luggageType LuggageType @relation(fields: [luggageTypeId], references: [id], onDelete: Restrict)

  @@unique([bookingId, luggageTypeId])
  @@index([luggageTypeId])
}

model BookingExtraService {
  id             String  @id @default(cuid())
  bookingId      String
  extraServiceId String
  quantity       Int     @default(1)
  returnQuantity Int     @default(0)
  unitPrice      Decimal @db.Decimal(12, 2)

  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  extraService ExtraService @relation(fields: [extraServiceId], references: [id], onDelete: Restrict)

  @@unique([bookingId, extraServiceId])
  @@index([extraServiceId])
}

model Quote {
  id                String   @id @default(cuid())
  vehicleCategoryId String
  inputHash         String
  input             Json
  pricing           Json
  total             Decimal  @db.Decimal(12, 2)
  expiresAt         DateTime
  createdAt         DateTime @default(now())

  vehicleCategory VehicleCategory @relation(fields: [vehicleCategoryId], references: [id], onDelete: Cascade)
  booking         Booking?

  @@index([expiresAt])
}
