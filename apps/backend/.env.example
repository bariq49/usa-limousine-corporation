NODE_ENV=development
PORT=3000
TRUST_PROXY=1
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/usa_limousine_corporation?schema=public
REDIS_URL=redis://localhost:6379
QUEUE_MODE=all
QUEUE_BOARD_ENABLED=true
QUEUE_BOARD_USERNAME=admin
QUEUE_BOARD_PASSWORD=replace-with-a-strong-secret
QUEUE_BOARD_PATH=/admin/queues
REDIS_SENTINELS=10.0.0.1:26379,10.0.0.2:26379
REDIS_SENTINEL_NAME=mymaster
REDIS_TLS_REJECT_UNAUTHORIZED=true
CORS_ORIGIN=http://localhost:3001,http://localhost:3002
WS_CORS_ORIGIN=http://localhost:3001,http://localhost:3002
WS_PORT=3000
WS_MAX_CONNECTIONS_PER_USER=5
WS_CONNECT_RATE_LIMIT_PER_MINUTE=30
WS_SESSION_REVALIDATE_SECONDS=60
JWT_ACCESS_SECRET=replace-with-a-32-character-access-secret
JWT_REFRESH_SECRET=replace-with-a-32-character-refresh-secret
JWT_ACCESS_TTL_SECONDS=43200
JWT_REFRESH_TTL_SECONDS=2592000
JWT_REMEMBER_ME_TTL_SECONDS=7776000
AUTH_COOKIE_NAME=usa_limo_refresh_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_HTTP_ONLY=true
AUTH_COOKIE_PATH=/
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_USER=noreply@example.com
EMAIL_PASS=replace-me
EMAIL_FROM=noreply@example.com
EMAIL_SECURE=true
DEFAULT_ADMIN_EMAIL=admin@example.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
STRIPE_SECRET_KEY_TEST=sk_test_replace_me
STRIPE_WEBHOOK_SECRET_TEST=whsec_test_replace_me
STRIPE_SECRET_KEY_LIVE=sk_live_replace_me
STRIPE_WEBHOOK_SECRET_LIVE=whsec_live_replace_me
PAYMENT_CHECKOUT_SUCCESS_URL=http://localhost:3001/booking/success
PAYMENT_CHECKOUT_CANCEL_URL=http://localhost:3001/booking/cancel
DRIVER_APP_URL=http://localhost:3002
CUSTOMER_APP_URL=http://localhost:3005
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+15551234567
AGORA_APP_ID=your-agora-app-id
AGORA_APP_CERTIFICATE=your-agora-app-certificate
AGORA_TOKEN_TTL_SECONDS=3600