enum HelpTicketStatus {
  PENDING
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum HelpTicketCategory {
  ACCOUNT
  BOOKING
  PAYMENTS
  APP
  OTHER
}

enum HelpTicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum HelpTicketSource {
  PORTAL
  WEBSITE
}

enum HelpTicketEventType {
  CREATED
  STATUS_CHANGED
  PRIORITY_CHANGED
  MESSAGE_ADDED
}

model HelpTicket {
  id           String             @id @default(cuid())
  ticketNumber String             @unique
  customerId   String?
  source       HelpTicketSource   @default(PORTAL)
  contactName  String?
  contactEmail String?
  contactPhone String?
  subject      String
  description  String
  attachment   String?
  category     HelpTicketCategory @default(OTHER)
  status       HelpTicketStatus   @default(PENDING)
  priority     HelpTicketPriority @default(MEDIUM)
  resolvedAt   DateTime?
  closedAt     DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  deletedAt    DateTime?

  customer Customer?           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages HelpTicketMessage[]
  events   HelpTicketEvent[]

  @@index([customerId, createdAt])
  @@index([source])
  @@index([contactEmail])
  @@index([status])
  @@index([category])
  @@index([priority])
  @@index([createdAt])
  @@index([deletedAt])
}

model HelpTicketMessage {
  id           String   @id @default(cuid())
  ticketId     String
  authorUserId String?
  body         String
  createdAt    DateTime @default(now())

  ticket HelpTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?      @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([createdAt])
}

model HelpTicketEvent {
  id               String              @id @default(cuid())
  ticketId         String
  event            HelpTicketEventType
  actorUserId      String?
  previousStatus   HelpTicketStatus?
  newStatus        HelpTicketStatus?
  previousPriority HelpTicketPriority?
  newPriority      HelpTicketPriority?
  note             String?
  createdAt        DateTime            @default(now())

  ticket HelpTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actor  User?      @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([ticketId])
  @@index([createdAt])
}
