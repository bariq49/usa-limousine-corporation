enum TripStatus {
  ACCEPTED
  STARTED
  ARRIVED_AT_PICKUP
  PASSENGER_ON_BOARD
  EN_ROUTE_TO_DROPOFF
  ARRIVED_AT_DROPOFF
  COMPLETED
  CANCELLED
}

enum TripEventType {
  ACCEPTED
  STARTED
  ARRIVED_AT_PICKUP
  PASSENGER_ON_BOARD
  EN_ROUTE_TO_DROPOFF
  ARRIVED_AT_DROPOFF
  COMPLETED
  CANCELLED
}

model Trip {
  id                  String     @id @default(cuid())
  bookingId           String     @unique
  driverId            String
  vehicleId           String
  status              TripStatus @default(ACCEPTED)
  /** Opaque token so guests can watch live location without a user account. */
  watchToken          String     @unique @default(cuid())
  acceptedAt          DateTime   @default(now())
  startedAt           DateTime?
  arrivedAtPickupAt   DateTime?
  pickedUpAt          DateTime?
  droppedOffAt        DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?
  driverNotes         String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  deletedAt           DateTime?

  booking        Booking             @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  driver         Driver              @relation(fields: [driverId], references: [id], onDelete: Restrict)
  vehicle        DriverVehicle       @relation(fields: [vehicleId], references: [id], onDelete: Restrict)
  events         TripEvent[]
  locationPoints TripLocationPoint[]
  review         TripReview?
  driverReview   DriverReview?
  requestEvents  DriverRequestEvent[]

  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
  @@index([startedAt])
  @@index([completedAt])
  @@index([deletedAt])
}

/** Driver rates the passenger after a completed trip (one review per trip). */
model TripReview {
  id        String   @id @default(cuid())
  tripId    String   @unique
  driverId  String
  bookingId String
  rating    Int
  comment   String?
  /** Snapshot of booking.passenger at review time. */
  passenger Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Restrict)

  @@index([driverId])
  @@index([bookingId])
  @@index([createdAt])
}

/** Customer rates the driver after a completed trip (one review per trip). */
model DriverReview {
  id         String   @id @default(cuid())
  tripId     String   @unique
  driverId   String
  bookingId  String
  customerId String
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  trip     Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver   Driver   @relation(fields: [driverId], references: [id], onDelete: Restrict)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  @@index([driverId])
  @@index([bookingId])
  @@index([customerId])
  @@index([createdAt])
}

model TripLocationPoint {
  id         String   @id @default(cuid())
  tripId     String
  driverId   String
  lat        Float
  lng        Float
  heading    Float?
  speed      Float?
  accuracy   Float?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  trip   Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([tripId, recordedAt])
  @@index([driverId, recordedAt])
}

model TripEvent {
  id             String        @id @default(cuid())
  tripId         String
  event          TripEventType
  actorUserId    String?
  previousStatus TripStatus?
  newStatus      TripStatus?
  metadata       Json?
  createdAt      DateTime      @default(now())

  trip  Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@index([event])
  @@index([createdAt])
  @@index([actorUserId])
}
